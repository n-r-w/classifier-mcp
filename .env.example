# Full System One endpoint URL and model are required. Neither has a default.
SYSTEM_ONE_ENDPOINT=https://openrouter.ai/api/v1/systemone
SYSTEM_ONE_MODEL=~typesafe/jev-latest
# Optional for unauthenticated compatible endpoints; OpenRouter requires a key.
SYSTEM_ONE_API_KEY=

# Positive duration for one complete HTTP request, including body reads. Default: 60s.
SYSTEM_ONE_HTTP_TIMEOUT=60s

# Positive process-wide active model request bound, shared by concurrent MCP calls. Default: 4.
SYSTEM_ONE_MAX_PARALLELISM=4
# Positive total attempts per object, including the first; retries only HTTP 429/529. Default: 3.
SYSTEM_ONE_MAX_ATTEMPTS=3
# Non-negative fallback delay when no valid Retry-After is supplied. Default: 1s.
# A supplied delay, including zero, replaces this value and is respected without a cap.
SYSTEM_ONE_RETRY_DELAY=1s
