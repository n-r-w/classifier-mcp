# Full System One endpoint URL and model are required. Neither has a default.
SYSTEM_ONE_ENDPOINT=https://openrouter.ai/api/v1/systemone
SYSTEM_ONE_MODEL=typesafe/jev-latest
# Optional for unauthenticated compatible endpoints; OpenRouter requires a key.
SYSTEM_ONE_API_KEY=

# Positive duration for one complete HTTP request, including body reads. Default: 60s.
SYSTEM_ONE_HTTP_TIMEOUT=60s
